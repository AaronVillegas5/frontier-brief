# The Frontier Brief — Environment Variables
# Copy this file to .env and fill in your values.

# Required: Google Gemini API key (get one at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Required: Resend API key (get one at https://resend.com/api-keys)
RESEND_API_KEY=your_resend_api_key_here

# Required: Sender email address
# Free-tier Resend accounts can ONLY send from onboarding@resend.dev
FROM_EMAIL=onboarding@resend.dev

# Required: Recipient email address
# Free-tier Resend accounts can ONLY deliver to your registered Resend account email
TO_EMAIL=your_email@example.com

# Optional: RSS.app token for X/Twitter feed bridge (https://rss.app)
# If not set, X/Twitter sentiment will attempt RSSHub and degrade gracefully
# RSS_APP_TOKEN=your_rss_app_token_here
